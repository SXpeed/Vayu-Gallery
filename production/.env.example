# Documentation only. No parent .env files are loaded by this application.
NODE_ENV=production
APP_ORIGIN=https://app.example.com
PORT=4180
# Separate logins: migration owner, API, identity service, and job runner.
DATABASE_URL=postgresql://vayu_api:REPLACE@localhost:5432/vayu
AUTH_DATABASE_URL=postgresql://vayu_identity:REPLACE@localhost:5432/vayu
JOBS_DATABASE_URL=postgresql://vayu_jobs:REPLACE@localhost:5432/vayu
MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE@localhost:5432/vayu
PG_CA_FILE=
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=REPLACE
OIDC_CLIENT_SECRET=REPLACE
# Exact ACR values your identity provider emits after MFA, comma separated.
OIDC_MFA_ACR=urn:example:aal2
STORAGE_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=vayu-private
STORAGE_ACCESS_KEY_ID=REPLACE
STORAGE_SECRET_ACCESS_KEY=REPLACE
# Random >=32-character secret, independent of all other credentials.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Optional HTTPS document verifier. Set BOTH in API and job environments to enable PDF uploads.
# DOCUMENT_SCANNER_URL=https://scanner.example.com/v1/pdf
# DOCUMENT_SCANNER_TOKEN=REPLACE_WITH_SCANNER_SERVICE_TOKEN
